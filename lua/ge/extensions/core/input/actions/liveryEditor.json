  "activate_previous_layer": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorEditMode",
    "onDown": "ui_liveryEditor_editMode.setActiveLayerDirection(-1)",
    "title": "ui.inputActions.liveryEditor.activate_previous_layer.title",
    "desc": "ui.inputActions.liveryEditor.activate_previous_layer.description"
  },
  "activate_next_layer": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorEditMode",
    "onDown": "ui_liveryEditor_editMode.setActiveLayerDirection(1)",
    "title": "ui.inputActions.liveryEditor.activate_next_layer.title",
    "desc": "ui.inputActions.liveryEditor.activate_next_layer.description"
  },
  "duplicate_active_layer": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorEditMode",
    "onDown": "ui_liveryEditor_editMode.duplicateActiveLayer()",
    "title": "ui.inputActions.liveryEditor.duplicate_active_layer.title",
    "desc": "ui.inputActions.liveryEditor.duplicate_active_layer.description"
  },

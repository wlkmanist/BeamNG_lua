  "rotate_left_decal": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorTransform",
    "onChange": "ui_liveryEditor_layerEdit.holdRotate(-1, VALUE)",
    "title": "ui.inputActions.liveryEditor.rotate_left_decal.title",
    "desc": "ui.inputActions.liveryEditor.rotate_left_decal.description"
  },
  "rotate_right_decal": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorTransform",
    "onChange": "ui_liveryEditor_layerEdit.holdRotate(1, VALUE)",
    "title": "ui.inputActions.liveryEditor.rotate_right_decal.title",
    "desc": "ui.inputActions.liveryEditor.rotate_right_decal.description"
  },
  "stamp_decal": {
    "cat": "gameplay",
    "order": 1,
    "ctx": "tlua",
    "actionMap": "liveryEditorTransformStamp",
    "onDown": "ui_liveryEditor_layerEdit.stampDecal()",
    "title": "ui.inputActions.liveryEditor.stamp_decal.title",
    "desc": "ui.inputActions.liveryEditor.stamp_decal.description"
  }
}